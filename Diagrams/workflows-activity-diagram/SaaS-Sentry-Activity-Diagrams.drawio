        <mxCell id="_e13" edge="1" parent="_pool" source="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A5A5A;strokeWidth=1.3;fontSize=10;fontColor=#3D3D3D;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=8;endFill=0;" target="fin2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nt0" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="BR-09.1  Risk assessment and cataloging are two different&lt;br&gt;roles within the same IT department. Merging them would force the Spending Approver&lt;br&gt;to decide spend on an app no one has risk-assessed.&lt;br&gt;The IT assessment and the Finance input are BOTH NOT approval steps;&lt;br&gt;the only decision-maker on this page is the Spending Approver (d4)" vertex="1">
          <mxGeometry height="100" width="380" x="1670" y="443" as="geometry" />
        </mxCell>
        <mxCell id="nt1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="BR-09.2  Not approved is a valid, positive outcome&lt;br&gt;when the company already has an equivalent tool" vertex="1">
          <mxGeometry height="73" width="258" x="1670" y="697" as="geometry" />
        </mxCell>
        <mxCell id="nt2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="BR-09.3  Apps touching highly sensitive data must have&lt;br&gt;Business Owner input before the spend-approval step" vertex="1">
          <mxGeometry height="73" width="258" x="1670" y="813" as="geometry" />
        </mxCell>
