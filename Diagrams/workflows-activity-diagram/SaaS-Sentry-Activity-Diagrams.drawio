        <mxCell id="nt0" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="BR-26.1  Counts from the cancellation deadline, not the renewal date.&lt;br&gt;A 7-day-before-renewal alert when the contract requires&lt;br&gt;30 days' notice is a useless alert sent right on time" vertex="1">
          <mxGeometry height="90" width="258" x="1672" y="423" as="geometry" />
        </mxCell>
        <mxCell id="nt1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="F-26  The T-15 milestone notifies IT Admin, Finance,&lt;br&gt;and the Business Owner; T-7 also notifies Super Admin.&lt;br&gt;BR-26.2  This is where the two subsystems meet: this plan is about&lt;br&gt;to renew, and 6 seats currently sit unused" vertex="1">
          <mxGeometry height="107" width="258" x="1672" y="962" as="geometry" />
        </mxCell>
        <mxCell id="nt2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBFBF4;strokeColor=#A8A8A8;fontSize=10;fontColor=#3D3D3D;align=left;spacingLeft=8;verticalAlign=middle;" value="BR-26.3  Auto-renewal without a decision&lt;br&gt;counts toward KPI-4 as an incident" vertex="1">
          <mxGeometry height="73" width="258" x="1672" y="1432" as="geometry" />
        </mxCell>
