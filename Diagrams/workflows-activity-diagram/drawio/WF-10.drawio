        <mxCell id="d3" parent="_lane_HT" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A5A;strokeWidth=1.4;fontSize=11;fontColor=#1F1F1F;" value="Has Cost&lt;br&gt;Involved?" vertex="1">
