          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_ne2" edge="1" parent="1" source="nt2" style="endArrow=none;html=1;dashed=1;dashPattern=3 3;strokeColor=#A8A8A8;strokeWidth=1;edgeStyle=none;" target="a5">
