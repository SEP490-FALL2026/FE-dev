<mxfile host="app.diagrams.net" type="device"><diagram id="UF-13" name="UF-13 Super Admin sửa cấu hình và luồng phê duyệt"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1115" pageHeight="1731" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-13 · Super Admin sửa cấu hình và luồng phê duyệt" vertex="1"><mxGeometry x="0" y="0" width="1011" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Super Admin — Ưu tiên trình bày: MỨC 2 · Trình bày nếu còn thời gian — Vai trò Super Admin chỉ có một flow; mở khi thầy hỏi về cấu hình và phân quyền" vertex="1"><mxGeometry x="0" y="30" width="1011" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Cần đổi ngưỡng phát hiện&lt;br&gt;hoặc chuỗi người duyệt" vertex="1"><mxGeometry x="410" y="80" width="192" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Đổi cái gì?" vertex="1"><mxGeometry x="386" y="243" width="240" height="81" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ADM-02&lt;/b&gt;&lt;br&gt;Chọn PHẠM VI áp dụng: từng ứng dụng &gt;&lt;br&gt;tổ chức &gt; mặc định hệ thống&lt;br&gt;BR-20.1" vertex="1"><mxGeometry x="30" y="416" width="278" height="96" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ADM-03&lt;/b&gt;&lt;br&gt;Sửa điều kiện và chuỗi bước duyệt&lt;br&gt;của một chính sách" vertex="1"><mxGeometry x="354" y="425" width="252" height="79" as="geometry"/></mxCell><mxCell id="a5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ADM-02&lt;/b&gt;&lt;br&gt;Chọn Người duyệt chi (một Employee, mặc định CEO),&lt;br&gt;người thay thế khi xung đột, ngưỡng backlog&lt;br&gt;và sửa nội dung thông báo theo dõi&lt;br&gt;FR-3.13 · FR-3.15 · FR-3.8 · FR-4.18" vertex="1"><mxGeometry x="652" y="408" width="330" height="113" as="geometry"/></mxCell><mxCell id="s5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Cấu hình, KHÔNG phải phê duyệt (SoD-1).&lt;br&gt;Nội dung đổi ⟹ phiên bản mới,&lt;br&gt;nhân viên xác nhận lại · BR-42.5" vertex="1"><mxGeometry x="720" y="626" width="291" height="79" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Hiện thứ tự ưu tiên đang áp dụng, ví dụ&lt;br&gt;“Figma dùng ngưỡng riêng, ghi đè mức tổ chức”" vertex="1"><mxGeometry x="0" y="634" width="330" height="62" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ADM-03&lt;/b&gt;&lt;br&gt;KHỐI XEM THỬ — chọn một tình huống&lt;br&gt;giả định, hệ thống chỉ ra chính sách nào&lt;br&gt;khớp và chuỗi bước sinh ra" vertex="1"><mxGeometry x="376" y="617" width="298" height="96" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Thao tác thuộc quyền&lt;br&gt;quản trị hệ thống?" vertex="1"><mxGeometry x="204" y="809" width="240" height="98" as="geometry"/></mxCell><mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Chuỗi bước sinh ra&lt;br&gt;đúng như ý không?" vertex="1"><mxGeometry x="490" y="809" width="240" height="98" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;SYS-04&lt;/b&gt;&lt;br&gt;CHẶN — Super Admin không gán suất&lt;br&gt;và không phê duyệt yêu cầu nghiệp vụ&lt;br&gt;BR-37.1 · SoD-1" vertex="1"><mxGeometry x="58" y="1015" width="272" height="96" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Áp cấu hình mới" vertex="1"><mxGeometry x="376" y="1040" width="190" height="45" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ADM-03&lt;/b&gt;&lt;br&gt;Sửa lại điều kiện&lt;br&gt;hoặc chuỗi bước" vertex="1"><mxGeometry x="764" y="1024" width="190" height="79" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Thao tác bị từ chối, có ghi nhật ký" vertex="1"><mxGeometry x="211" y="1219" width="265" height="62" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Ghi nhật ký kiểm toán — CHỈ GHI THÊM,&lt;br&gt;không sửa không xóa · BR-38.1" vertex="1"><mxGeometry x="522" y="1219" width="278" height="62" as="geometry"/></mxCell><mxCell id="s4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Yêu cầu ĐANG CHẠY giữ chính sách cũ;&lt;br&gt;đổi người giữ vai thì bước đang chờ&lt;br&gt;được xác định lại · BR-37.2 · BR-13.9" vertex="1"><mxGeometry x="366" y="1365" width="278" height="79" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Cấu hình có hiệu lực cho&lt;br&gt;yêu cầu tạo từ nay" vertex="1"><mxGeometry x="410" y="1528" width="192" height="79" as="geometry"/></mxCell><mxCell id="UF-13_e0" edge="1" parent="1" source="st" target="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="506" y="185"/><mxPoint x="506" y="185"/></Array></mxGeometry></mxCell><mxCell id="UF-13_e1" edge="1" parent="1" source="d1" target="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="ngưỡng phát hiện"><mxGeometry relative="1" as="geometry" x="1"><Array as="points"><mxPoint x="506" y="350"/><mxPoint x="168" y="350"/></Array><mxPoint y="-13" 