iên" vertex="1"><mxGeometry x="166" y="2056" width="258" height="62" as="geometry"/></mxCell><mxCell id="d5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Còn định danh&lt;br&gt;chưa khớp được?" vertex="1"><mxGeometry x="16" y="2202" width="240" height="98" as="geometry"/></mxCell><mxCell id="o2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-16&lt;/b&gt;&lt;br&gt;Dữ liệu từ bộ thu thập trên thiết bị&lt;br&gt;đi qua CÙNG bước khớp danh tính" vertex="1"><mxGeometry x="302" y="2212" width="272" height="79" as="geometry"/></mxCell><mxCell id="o1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-07&lt;/b&gt;&lt;br&gt;Hàng đợi chưa khớp danh tính —&lt;br&gt;bản ghi chưa khớp KHÔNG dùng&lt;br&gt;để kết luận (BR-18.1)" vertex="1"><mxGeometry x="0" y="2384" width="232" height="96" as="geometry"/></mxCell><mxCell id="a8" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-07 · Bước 4&lt;/b&gt;&lt;br&gt;XEM TRƯỚC — chưa ghi dòng nào.&lt;br&gt;Số dòng hợp lệ · lỗi · trùng · chưa khớp ·&lt;br&gt;cửa sổ bao phủ · năng lực của nguồn" vertex="1"><mxGeometry x="278" y="2384" width="311" height="96" as="geometry"/></mxCell><mxCell id="d6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Xác nhận ghi dữ liệu?" vertex="1"><mxGeometry x="174" y="2564" width="240" height="81" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;str