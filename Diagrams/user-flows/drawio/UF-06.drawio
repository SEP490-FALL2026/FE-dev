<mxfile host="app.diagrams.net" type="device"><diagram id="UF-06" name="UF-06 IT Admin nạp dữ liệu sử dụng"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="3258" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-06 · IT Admin nạp dữ liệu sử dụng" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin — Ưu tiên trình bày: MỨC 2 · Trình bày nếu còn thời gian — Mở NGAY khi thầy hỏi “dữ liệu sử dụng ở đâu ra” hoặc “có xin phép người lao động không”" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;IT có file nhật ký sử dụng" vertex="1"><mxGeometry x="192" y="80" width="206" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-08&lt;/b&gt;&lt;br&gt;Chọn ứng dụng và mẫu cấu hình nguồn" vertex="1"><mxGeometry x="162" y="226" width="265" height="62" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Ứng dụng thuộc nhóm&lt;br&gt;dịch vụ liên lạc?" vertex="1"><mxGeometry x="174" y="372" width="240" height="98" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;ITA-08&lt;/b&gt;&lt;br&gt;CHẶN — mặc định không thu thập&lt;br&gt;dữ liệu hoạt động · BR-17.8 · ADR-10" vertex="1"><mxGeometry x="16" y="564" width="272" height="79" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Lần đầu import cho&lt;br&gt;ứng dụng này?" vertex="1"><mxGeometry x="334" y="554" width="240" height="98" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-07 · Cổng F-42&lt;/b&gt;&lt;br&gt;Xác nhận đã thông báo&lt;br&gt;cho người lao động" vertex="1"><mxGeometry x="280" y="748" width="190" height="79" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Không import — chỉ dùng&lt;br&gt;danh sách thành viên" vertex="1"><mxGeometry x="44" y="748" width="190" height="79" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-07 · Bước 1&lt;/b&gt;&lt;br&gt;Tải file lên, hệ thống tính mã băm" vertex="1"><mxGeometry x="166" y="1074" width="258" height="62" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Gửi thông báo tới mọi nhân viên đang&lt;br&gt;giữ suất · ghi nhật ký thời điểm.&lt;br&gt;Chưa thông báo thì KHÔNG cho ghi (BR-42.2)" vertex="1"><mxGeometry x="101" y="911" width="311" height="79" a