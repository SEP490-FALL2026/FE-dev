<mxfile host="app.diagrams.net" type="device"><diagram id="UF-14" name="UF-14 IT Admin xử lý sai lệch và mâu thuẫn dữ liệu"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1095" pageHeight="2489" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-14 · IT Admin xử lý sai lệch và mâu thuẫn dữ liệu" vertex="1"><mxGeometry x="0" y="0" width="1015" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin + Finance — Ưu tiên trình bày: MỨC 3 · Chỉ mở khi bị hỏi — Tra cứu — mở khi thầy hỏi “hai nguồn dữ liệu lệch nhau thì tin cái nào”" vertex="1"><mxGeometry x="0" y="30" width="1015" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Tác vụ đối soát chạy theo lịch,&lt;br&gt;hoặc Tài chính import hóa đơn" vertex="1"><mxGeometry x="388" y="80" width="239" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Loại đối soát?" vertex="1"><mxGeometry x="388" y="243" width="240" height="81" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-11&lt;/b&gt;&lt;br&gt;Đối soát danh sách thành viên&lt;br&gt;phía nhà cung cấp" vertex="1"><mxGeometry x="277" y="408" width="225" height="79" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;FIN-04&lt;/b&gt;&lt;br&gt;Ghép dòng hóa đơn về&lt;br&gt;đúng thuê bao" vertex="1"><mxGeometry x="548" y="408" width="190" height="79" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Ứng dụng có&lt;br&gt;kết nối tự động?" vertex="1"><mxGeometry x="216" y="571" width="240" height="98" as="geometry"/></mxCell><mxCell id="s0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Hiện BA con số cạnh nhau: trên hóa đơn ·&lt;br&gt;khai trong thuê bao · đang thực sự dùng" vertex="1"><mxGeometry x="502" y="589" width="298" height="62" as="geometry"/></mxCell><mxCell id="e0" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Không đối soát — không sinh&lt;br&gt;sai lệch giả · BR-28.1" vertex="1"><mxGeometry x="30" y="762" width="212" height="79" as="geometry"/></mxCell><mxCell id="dq" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Chênh lệch gắn với một ProvisioningTask&lt;br&gt;đang CHỜ CHẤP NHẬN?" vertex="1"><mxGeometry x="288" y="753" width="341" height="98" as="geometry"/></mxCell><mxCell id="dq2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Đã là thành viên active&lt;br&gt;đúng tài khoản?" vertex="1"><mxGeometry x="312" y="947" width="240" height="98" as="geometry"/></mxCell><mxCell id="eq" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;fontStyle=1;" value="KẾT THÚC&lt;br&gt;Vẫn chờ chấp nhận — giữ chờ, không sinh sai lệch" vertex="1"><mxGeometry x="0" y="1150" width="330" height="62" as="geometry"/></mxCell><mxCell id="s5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Ghi bằng chứng nhà cung cấp · chuyển&lt;br&gt;ProvisioningTask CHỜ CHẤP NHẬN → HOÀN TẤT&lt;br&gt;BRD mục 5.12.3 · 6.3 · QĐ-03" vertex="1"><mxGeometry x="376" y="1141" width="305" height="79" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Tác vụ cấp phát ĐÃ LIÊN KẾT hoàn tất,&lt;br&gt;có bằng chứng phía nhà cung cấp" vertex="1"><mxGeometry x="190" y="1316" width="278" height="79" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-11&lt;/b&gt;&lt;br&gt;Hai loại sai lệch, phân mức&lt;br&gt;nghiêm trọng khác nhau" vertex="1"><mxGeometry x="727" y="1141" width="212" height="79" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chênh lệch phải quy được về MỘT trong&lt;br&gt;ba nguyên nhân: mua thêm chưa cập nhật ·&lt;br&gt;nhà cung cấp tính sai · dữ liệu nội bộ sai&lt;br&gt;BR-35.2" vertex="1"><mxGeometry x="674" y="754" width="311" height="96" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Giữ nguyên CẢ HAI giá trị — hệ thống KHÔNG&lt;br&gt