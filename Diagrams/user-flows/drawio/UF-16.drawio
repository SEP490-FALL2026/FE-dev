<mxfile host="app.diagrams.net" type="device"><diagram id="UF-16" name="UF-16 IT Admin triển khai bộ thu thập, nhân viên xác nhận theo dõi"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="2046" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-16 · IT Admin triển khai bộ thu thập, nhân viên xác nhận theo dõi" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin + Employee — Ưu tiên trình bày: MỨC 2 · Trình bày nếu còn thời gian — Mở khi thầy hỏi &quot;theo dõi mức sử dụng trên máy công ty có hợp pháp không&quot;" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;IT triển khai tiện ích cho một thiết bị công ty" vertex="1"><mxGeometry x="133" y="80" width="330" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-16 · Thiết bị và bộ thu thập&lt;/b&gt;&lt;br&gt;Đăng ký thiết bị ↔ nhân viên,&lt;br&gt;có ngày hiệu lực" vertex="1"><mxGeometry x="176" y="226" width="245" height="79" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Sinh danh sách cho phép từ danh mục&lt;br&gt;và từ điển, TRỪ ứng dụng liên lạc&lt;br&gt;BR-45.4 · ADR-10" vertex="1"><mxGeometry x="166" y="389" width="265" height="79" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Gửi thông báo theo dõi có đánh phiên bản" vertex="1"><mxGeometry x="149" y="552" width="298" height="45" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;EMP-05 · Thông báo theo dõi&lt;/b&gt;&lt;br&gt;Thu gì · KHÔNG thu gì · mục đích ·&lt;br&gt;thời hạn lưu · quyền yêu cầu dừng" vertex="1"><mxGeometry x="169" y="681" width="258" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Nhân viên bấm&lt;br&gt;xác nhận đã đọc?" vertex="1"><mxGeometry x="178" y="844" width="240" height="98" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;ITA-16&lt;/b&gt;&lt;br&gt;Thiết bị ở trạng thái CHƯA XÁC NHẬN —&lt;br&gt;không nhận dữ liệu · BR-45.1" vertex="1"><mxGeometry x="0" y="1026" width="278" height="79" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Ứng dụng của người này chỉ còn&lt;br&gt;G1/G2 từ nguồn nhà cung cấp" vertex="1"><mxGeometry x="10" y="1189" width="232" height="79" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="