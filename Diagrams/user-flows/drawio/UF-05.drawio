<mxfile host="app.diagrams.net" type="device"><diagram id="UF-05" name="UF-05 Quản lý xác nhận license"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1649" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-05 · Quản lý xác nhận license" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Manager — Ưu tiên trình bày: MỨC 1 · Bắt buộc trình bày — Màn hình quyết định phân hệ Ghost Seat sống hay chết — nơi hệ thống nói thật về mức độ chắc chắn của nó" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Nhận hàng đợi xác nhận, gộp theo tuần" vertex="1"><mxGeometry x="236" y="80" width="278" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-04&lt;/b&gt;&lt;br&gt;Nhóm theo NHÂN VIÊN, không nhóm theo&lt;br&gt;ứng dụng. Nút “Xem log” bị vô hiệu&lt;br&gt;kèm lý do — SoD-2 · BR-21.1" vertex="1"><mxGeometry x="239" y="226" width="272" height="96" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Mỗi dòng hiện: số ngày không hoạt động ·&lt;br&gt;tên nguồn · ngày import · cửa sổ bao phủ ·&lt;br&gt;phương pháp khớp · định nghĩa “hoạt động” ·&lt;br&gt;mức tin cậy · HAI con số tiết kiệm tách biệt" vertex="1"><mxGeometry x="213" y="406" width="324" height="96" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Bằng chứng đủ chắc&lt;br&gt;để quyết ngay?" vertex="1"><mxGeometry x="255" y="586" width="240" height="98" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;MGR-04&lt;/b&gt;&lt;br&gt;Dòng cảnh báo giới hạn dữ liệu:&lt;br&gt;“nguồn chỉ bao phủ 30 ngày —&lt;br&gt;chưa đủ để kết luận” · BR-21.4" vertex="1"><mxGeometry x="218" y="768" width="239" height="96" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Lựa chọn của tôi?" vertex="1"><mxGeometry x="255" y="948" width="240" height="81" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-04&lt;/b&gt;&lt;br&gt;Nhập lý do giữ lại" vertex="1"><mxGeometry x="0" y="1122" width="190" height="62" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-04&lt;/b&gt;&lt;br&gt;Nhập lý do thu hồi" vertex="1"><mxGeometry x="236" y="1122" width="190" height="62" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-04&lt;/b&gt;&lt;b