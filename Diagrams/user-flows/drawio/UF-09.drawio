<mxfile host="app.diagrams.net" type="device"><diagram id="UF-09" name="UF-09 IT Admin xử lý nhân viên nghỉ việc"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="2698" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-09 · IT Admin xử lý nhân viên nghỉ việc" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin — Ưu tiên trình bày: MỨC 1 · Bắt buộc trình bày — Kịch bản demo giá trị nhất: vừa là chi phí vừa là lỗ hổng bảo mật, và chỉ dùng dữ liệu nội bộ" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Nhân sự báo một nhân viên nghỉ việc" vertex="1"><mxGeometry x="169" y="80" width="265" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-12 · Danh sách nhân sự&lt;/b&gt;&lt;br&gt;Mở hồ sơ nhân viên" vertex="1"><mxGeometry x="198" y="226" width="206" height="62" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-13&lt;/b&gt;&lt;br&gt;Chuyển trạng thái “Đang bàn giao”,&lt;br&gt;đặt NGÀY LÀM VIỆC CUỐI — bắt buộc&lt;br&gt;BR-05.3" vertex="1"><mxGeometry x="172" y="372" width="258" height="96" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Liệt kê toàn bộ suất đang giữ ·&lt;br&gt;gửi quản lý danh sách bàn giao kèm hạn" vertex="1"><mxGeometry x="159" y="552" width="285" height="62" as="geometry"/></mxCell><mxCell id="s7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chấm dứt đăng ký thiết bị công ty —&lt;br&gt;cổng nhận từ chối dữ liệu từ thiết bị&lt;br&gt;BR-45.7" vertex="1"><mxGeometry x="162" y="698" width="278" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Người này là quản lý của người khác,&lt;br&gt;hoặc là Business Owner?" vertex="1"><mxGeometry x="140" y="861" width="322" height="98" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-14&lt;/b&gt;&lt;br&gt;Chỉ định người kế nhiệm và&lt;br&gt;người thay Business Owner" vertex="1"><mxGeometry x="160" y="1043" width="206" height="79" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chờ tới ngày làm việc cuối" vertex="1"><mxGeometry x="198" y="1206" width="206" height="45" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Sinh khuyến nghị nhóm G2 cho mọi suất&lt;br&gt;còn lại — bỏ qua mọi ngưỡng ngày, mức&lt;br&gt;cần xử lý ngay · BR-05.1" vertex="1"><mxGeometry x="162" y="1335" width="278" height="79" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-10&lt;/b&gt;&lt;br&gt;Thẻ G2 — KHÔNG cần quản lý xác nhận,&lt;br&gt;chuyển thẳng cho IT · BR-05.2" vertex="1"><mxGeometry x="166" y="1498" width="272" height="79" as="geometry"/></mxCell><mxCell id="a5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-10&lt;/b&gt;&lt;br&gt;Thu hồi hàng loạt — GÕ SỐ LƯỢNG&lt;br&gt;để xác nhận và nhập lý do chung&lt;br&gt;BR-05.4" vertex="1"><mxGeometry x="182" y="1661" width="239" height="96" as="geometry"/></mxCell><mxCell id="s4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Gửi task xóa tài khoản; giữ trạng thái&lt;br&gt;chờ bằng chứng — chưa trả seat" vertex="1"><mxGeometry x="159" y="1841" width="285" height="62" as="geometry"/></mxCell><mxCell id="o1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-08&lt;/b&gt;&lt;br&gt;Xem chi tiết thực thi task xóa tài khoản" vertex="1"><mxGeometry x="10" y="2014" width="298" height="62" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Đủ bằng chứng BR-14.2?&lt;br&gt;Đã xóa hoặc IT xác nhận&lt;br&gt;không cần xóa" vertex="1"><mxGeometry x="354" y="1987" width="240" height="115" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColo