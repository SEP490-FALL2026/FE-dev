<mxfile host="app.diagrams.net" type="device"><diagram id="UF-12" name="UF-12 Phát hiện và hợp thức hóa phần mềm ngoài danh mục"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="2497" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-12 · Phát hiện và hợp thức hóa phần mềm ngoài danh mục" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Finance + IT Admin — Ưu tiên trình bày: MỨC 1 · Bắt buộc trình bày — D-4 — đưa Shadow IT vào diện quản trị mà không kết tội; vòng lặp khép kín về lại danh mục" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Có sao kê hoặc dữ liệu cấp quyền mới" vertex="1"><mxGeometry x="277" y="80" width="272" height="62" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Nguồn bằng chứng?" vertex="1"><mxGeometry x="293" y="226" width="240" height="81" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;FIN-04&lt;/b&gt;&lt;br&gt;Tài chính import sao kê,&lt;br&gt;danh sách hóa đơn" vertex="1"><mxGeometry x="0" y="400" width="192" height="79" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-07&lt;/b&gt;&lt;br&gt;IT import dữ liệu cấp quyền&lt;br&gt;của hệ thống định danh" vertex="1"><mxGeometry x="238" y="400" width="212" height="79" as="geometry"/></mxCell><mxCell id="a8" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;Bộ thu thập: tên miền có trong từ điển&lt;br&gt;nhưng ngoài danh mục — số nhân viên đã xác nhận&lt;br&gt;có mở, khoảng ngày; KHÔNG có URL · BR-46.1" vertex="1"><mxGeometry x="496" y="391" width="330" height="96" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chuẩn hóa mô tả giao dịch về tên nhà cung cấp&lt;br&gt;— lưu CẢ giá trị thô lẫn giá trị đã chuẩn hóa&lt;br&gt;kèm phương pháp khớp · BR-31.4" vertex="1"><mxGeometry x="210" y="583" width="330" height="79" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Phương pháp khớp&lt;br&gt;nào được dùng?" vertex="1"><mxGeometry x="255" y="746" width="240" height="98" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Khớp chính xác từ điển hoặc theo mẫu&lt;br&gt;→ tự động chuẩn hóa" vertex="1"><mxGeometry x="80" y="945" width="272" height="62" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;BẮT BUỘC người xác nhận — kết quả do&lt;br&gt;mô hình ngôn ngữ gợi ý luôn ở mức&lt;br&gt;tin cậy thấp · FR-6.5" vertex="1"><mxGeometry x="398" y="928" width="272" height="96" as="geometry"/></mxCell><mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Nhà cung cấp đã có trong&lt;br&gt;danh mục đã duyệt?" vertex="1"><mxGeometry x="292" y="1120" width="242" height="98" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Chi tiêu đã nằm trong danh mục" vertex="1"><mxGeometry x="112" y="1310" width="232" height="62" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Sinh bản ghi CẦN XEM XÉT — không phải&lt;br&gt;kết luận vi phạm (BR-31.1). Mỗi nhà cung cấp&lt;br&gt;chỉ một bản ghi đang mở (BR-31.2)" vertex="1"><mxGeometry x="390" y="1302" width="324" height="79" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;Phát hiện ngoài danh mục — phân tầng rủi ro&lt;br&gt;theo mức nhạy cảm dữ liệu, số nhân viên&lt;br&gt;liên quan, có đăng nhập tập trung không" vertex="1"><mxGeometry x="254" y="1465" width="318" height="96" as="geometry"/></mxCell><mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Quyết định của IT?" vertex="1"><mxGeometry x="293" y="1645" width="240" height="81" as="geometry"/></mxCell><mxCell id="a5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;Đánh dấu BÁO NHẦM" vertex="1"><mxGeometry x="54" y="1810" width="190" height="62" as="geometry"/></mxCell><mxCell id="a6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;Đánh dấu ĐÃ DUYỆT — hợp thức hóa" vertex="1"><mxGeometry x="290" y="1810" width="245" height="62" as="geometry"/></mxCell><mxCell id="a7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-15&lt;/b&gt;&lt;br&gt;Đánh dấu CHƯA DUYỆT" vertex="1"><mxGeometry x="582" y="1810" width="190" height="62" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Đóng; xuất hiện lại thì MỞ LẠI&lt;br&gt;BR-31.3" vertex="1"><mxGeometry x="26" y="1968" width="232" height="79" as="geometry"/></mxCell><mxCell id="o1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-03&lt;/b&gt;&lt;br&gt;Khai báo đầy đủ vào danh mục,&lt;br&gt;tạo yêu cầu mua chính thức (F-06)" vertex="1"><mxGeometry x="304" y="1968" width="252" height="79" as="geometry"/></mxCell><mxCell id="o2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-08&lt;/b&gt;&lt;br&gt;Thu hồi, hướng người dùng&lt;br&gt;sang công cụ sẵn có" vertex="1"><mxGeometry x="602" y="1968" width="199" height="79" as="geometry"/></mxCell><mxCell id="s4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Ghi nhận người đang dùng thành QUYỀN&lt;br&gt;CHÍNH THỨC — không bắt xin lại từ đầu&lt;br&gt;BR-34.2" vertex="1"><mxGeometry x="274" y="2131" width="278" height="79" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;“Đã duyệt” là kết cục bình thường&lt;br&gt;và tích cực · BR-34.1" vertex="1"><mxGeometry x="287" y="2294" width="252" height="79" as="geometry"/></mxCell><mxCell id="UF-12_e0" edge="1" parent="1" source="st" target="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="413" y="168"/><mxPoint x="413" y="168"/></Array></mxGeometry></mxCell><mxCell id="UF-12_e1" edge="1" parent="1" source="d1" target="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="sao kê ngân hàng"><mxGeometry relative="1" as="geometry" x="1"><Array as="points"><mxPoint x="413" y="333"/><mxPoint x="96" y="333"/></Array><mxPoint y="-13" as="offset"/></mxGeometry></mxCell><mxCell id="UF-12_e2" edge="1" parent="1" source="d1" target="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0