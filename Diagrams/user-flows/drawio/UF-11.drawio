<mxfile host="app.diagrams.net" type="device"><diagram id="UF-11" name="UF-11 Tài chính kiểm soát ngân sách và theo dõi kỳ gia hạn"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1436" pageHeight="1524" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-11 · Tài chính kiểm soát ngân sách và theo dõi kỳ gia hạn" vertex="1"><mxGeometry x="0" y="0" width="1356" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Finance — Ưu tiên trình bày: MỨC 1 · Bắt buộc trình bày — Mắt xích biến khuyến nghị thành tiền thật; cảnh báo đếm từ hạn chót báo hủy chứ không từ ngày gia hạn. (v0.7 — Tài chính không nằm trên đường duyệt: trả lời khi Người duyệt chi hỏi, ghi nhận sau duyệt; Người duyệt chi quyết: UF-15)" vertex="1"><mxGeometry x="0" y="30" width="1356" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Tài chính mở hệ thống" vertex="1"><mxGeometry x="583" y="80" width="190" height="62" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Việc cần xử lý?" vertex="1"><mxGeometry x="558" y="226" width="240" height="81" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;FIN-05&lt;/b&gt;&lt;br&gt;Yêu cầu thông tin ngân sách từ&lt;br&gt;Người duyệt chi — tùy chọn; SLA bước&lt;br&gt;duyệt chi KHÔNG dừng · BR-07.9" vertex="1"><mxGeometry x="218" y="391" width="272" height="96" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;FIN-03&lt;/b&gt;&lt;br&gt;Lịch gia hạn — mốc đánh dấu là HẠN CHÓT&lt;br&gt;BÁO HỦY, không phải ngày gia hạn&lt;br&gt;BR-26.1" vertex="1"><mxGeometry x="536" y="391" width="291" height="96" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;FIN-05&lt;/b&gt;&lt;br&gt;Snapshot: ngân sách kỳ · thực chi ·&lt;br&gt;cam kết đang giữ · còn lại · đang chờ duyệt" vertex="1"><mxGeometry x="78" y="584" width="318" height="79" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Mỗi mốc hiện kèm KHUYẾN NGHỊ LÃNG PHÍ&lt;br&gt;ĐANG MỞ của chính thuê bao đó · BR-26.2" vertex="1"><mxGeometry x="442" y="592" width="291" height="62" as="geometry"/></mxCell><mxCell id="s6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Trả lời: trong hạn mức · vượt hạn mức ·&lt;br&gt;chưa có ngân sách — KHÔNG duyệt,&lt;br&gt;KHÔNG chặn" vertex="1"><mxGeometry x="220" y="772" width="291" height="79" as="geometry"/></mxCell><mxCell id="o3" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-15&lt;/b&gt;&lt;br&gt;Người duyệt chi quyết định" vertex="1"><mxGeometry x="0" y="977" width="206" height="62" as="geometry"/></mxCell><mxCell id="e5" parent