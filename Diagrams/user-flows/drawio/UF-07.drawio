<mxfile host="app.diagrams.net" type="device"><diagram id="UF-07" name="UF-07 IT Admin xử lý hàng đợi chưa khớp danh tính"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1462" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-07 · IT Admin xử lý hàng đợi chưa khớp danh tính" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin — Ưu tiên trình bày: MỨC 3 · Chỉ mở khi bị hỏi — Tra cứu — mở khi thầy hỏi “khớp tài khoản bên nhà cung cấp với nhân viên bằng cách nào”" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Sau một lần import&lt;br&gt;còn định danh chưa khớp" vertex="1"><mxGeometry x="306" y="80" width="190" height="79" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-09&lt;/b&gt;&lt;br&gt;Hàng đợi chưa khớp — hiện CHUỖI GỐC&lt;br&gt;nguyên văn bên cạnh bản đã chuẩn hóa&lt;br&gt;BR-18.2" vertex="1"><mxGeometry x="264" y="243" width="272" height="96" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-09&lt;/b&gt;&lt;br&gt;Xem gợi ý ứng viên gần đúng&lt;br&gt;kèm phương pháp và độ tin cậy" vertex="1"><mxGeometry x="288" y="423" width="225" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Tìm được nhân viên&lt;br&gt;tương ứng?" vertex="1"><mxGeometry x="280" y="586" width="240" height="98" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-09&lt;/b&gt;&lt;br&gt;Đánh dấu bỏ qua, ghi lý do" vertex="1"><mxGeometry x="154" y="786" width="206" height="62" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Định danh này khớp về&lt;br&gt;hai nhân viên khác nhau?" vertex="1"><mxGeometry x="406" y="768" width="242" height="98" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Bản ghi không dùng để&lt;br&gt;kết luận về bất kỳ ai (BR-18.1)" vertex="1"><mxGeometry x="0" y="958" width="239" height="79" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-09&lt;/b&gt;&lt;br&gt;Gán tay và ghi TÊN NGƯỜI XÁC NHẬN,&lt;br&gt;ghi phương pháp khớp là thủ công&lt;br&gt;BR-18.3" vertex="1"><mxGeometry x="285" y="950" width="258" height="96" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;ITA-09&lt;/b&gt;&lt;br&gt;CHẶN — đẩy lên người xử lý,&lt;br&gt;không tự chọn một trong hai&lt;br&gt;BR-18.4" vertex="1"><mxGeometry x="589" y="950" width="212" height="96" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chạy lại tổng hợp cho các quyền&lt;br&gt;liên quan tới định danh vừa khớp" vertex="1"><mxGeometry x="146" y="1130" width="245" height="62" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Chờ xử lý xung đột danh tính" vertex="1"><mxGeometry x="436" y="1130" width="219" height="62" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Hàng đợi giảm sau mỗi kỳ import" vertex="1"><mxGeometry x="281" y="1276" width="239" height="62" as="geometry"/></mxCell><mxCell id="UF-07_e0" edge="1" parent="1" source="st" target="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="185"/><mxPoint x="400" y="185"/></Array></mxGeometry></mxCell><mxCell id="UF-07_e1" edge="1" parent="1" source="a1" target="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40