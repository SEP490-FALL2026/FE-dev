<mxfile host="app.diagrams.net" type="device"><diagram id="UF-08" name="UF-08 IT Admin xử lý hàng đợi cấp phát"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1277" pageHeight="2147" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-08 · IT Admin xử lý hàng đợi cấp phát" vertex="1"><mxGeometry x="0" y="0" width="1173" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: IT Admin — Ưu tiên trình bày: MỨC 3 · Chỉ mở khi bị hỏi — Tra cứu — mở khi thầy hỏi “cấp phát lỗi thì sao” hoặc “ứng dụng không có API thì làm thế nào”" vertex="1"><mxGeometry x="0" y="30" width="1173" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Một yêu cầu đã đủ phê duyệt" vertex="1"><mxGeometry x="480" y="80" width="212" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-05&lt;/b&gt;&lt;br&gt;Ba tab: Cần làm tay · Đang chạy tự động&lt;br&gt;· Thất bại — cùng một máy trạng thái" vertex="1"><mxGeometry x="441" y="226" width="291" height="79" as="geometry"/></mxCell><mxCell id="s0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Quyền CHIẾM CHỖ suốt thời gian thực thi,&lt;br&gt;kể cả khi thất bại · BR-10.4" vertex="1"><mxGeometry x="438" y="389" width="298" height="62" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Ứng dụng có&lt;br&gt;kết nối tự động?" vertex="1"><mxGeometry x="466" y="535" width="240" height="98" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Hệ thống gọi giao diện lập trình&lt;br&gt;của nhà cung cấp" vertex="1"><mxGeometry x="288" y="726" width="245" height="62" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-05&lt;/b&gt;&lt;br&gt;Thẻ việc làm tay — bấm “Tôi đang xử lý”,&lt;br&gt;thao tác trên trang quản trị nhà cung cấp" vertex="1"><mxGeometry x="580" y="717" width="305" height="79" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Kết quả thực thi?" vertex="1"><mxGeometry x="466" y="1043" width="240" height="81" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-05&lt;/b&gt;&lt;br&gt;Bấm “Đã hoàn tất”, ghi tên người thực hiện.&lt;br&gt;Hệ thống KHÔNG tự chuyển · BR-10.1" vertex="1"><mxGeometry x="466" y="880" width="318" height="79" as="geometry"/></mxCell><mxCell id="dp" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Kênh tự động, và nhà cung cấp&lt;br&gt;mới chỉ tạo LỜI MỜI chờ chấp nhận?" vertex="1"><mxGeometry x="264" y="1208" width="308" height="98" as="geometry"/></mxCell><mxCell id="sp" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Giữ ProvisioningTask ở trạng thái&lt;br&gt;CHỜ CHẤP NHẬN — KHÔNG ghi hoàn tất.&lt;br&gt;Suất vẫn chiếm chỗ · BR-10.4&lt;br&gt;UF-14 đối soát rồi mới chuyển CHÍNH task này&lt;br&gt;sang HOÀN TẤT · BRD mục 5.12.3 · 6.3 · QĐ-03" vertex="1"><mxGeometry x="149" y="1390" width="324" height="113" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;fontStyle=1;" value="KẾT THÚC (chưa xong)&lt;br&gt;Đã gửi lời mời — CHƯA hoàn tất cấp phát.&lt;br&gt;Hoàn tất hoặc sai lệch được quyết ở UF-14" vertex="1"><mxGeometry x="0" y="1608" width="305" height="79" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Ghi bằng chứng vào nhật ký ·&lt;br&gt;thông báo người yêu cầu" vertex="1"><mxGeometry x="519" y="1416" width="219" height="62" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;ITA-05&lt;/b&gt;&lt;br&gt;Thẻ lỗi — bốn loại, câu tiếng Việt;&lt;br&gt;mã lỗi nằm trong khối chi tiết kỹ thuật&lt;br&gt;BR-12.4" vertex="1"><mxGeometry x="618" y="1209" width="291" height="96" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Có bằng chứng tài khoản đã tồn tại&lt;br&gt;hoặc đã bị xóa phía nhà cung cấp" vertex="1"><mxGeometry x="637" y="1608" width="258" height="79" as="geometry"/></mxCell><mxCell id="d3" parent