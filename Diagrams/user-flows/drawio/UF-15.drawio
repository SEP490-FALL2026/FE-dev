<mxfile host="app.diagrams.net" type="device"><diagram id="UF-15" name="UF-15 Người duyệt chi duyệt khoản chi và quyết định kỳ gia hạn"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1655" pageHeight="1527" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-15 · Người duyệt chi duyệt khoản chi và quyết định kỳ gia hạn" vertex="1"><mxGeometry x="0" y="0" width="1575" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Người duyệt chi (mặc định CEO) · hoặc người thay thế khi xung đột với đúng Request mà Người duyệt chi là người yêu cầu/thụ hưởng — Ưu tiên trình bày: MỨC 1 · Bắt buộc trình bày — Góp ý của mentor: người có thẩm quyền chi quyết cuối; Tài chính báo cáo khi được hỏi và ghi nhận sau (v0.7 — QĐ-29b)" vertex="1"><mxGeometry x="0" y="30" width="1575" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Có khoản chi hoặc kỳ gia hạn chờ tôi" vertex="1"><mxGeometry x="652" y="80" width="272" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;APV-01 · Hàng đợi duyệt chi&lt;/b&gt;&lt;br&gt;Loại việc · thời hạn còn lại theo SLA&lt;br&gt;Quá hạn thì nhắc và thông báo, không đổi người · BR-07.7" vertex="1"><mxGeometry x="622" y="226" width="330" height="79" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Loại việc?" vertex="1"><mxGeometry x="668" y="389" width="240" height="81" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;APV-02 · Panel quyết định&lt;/b&gt;&lt;br&gt;Nhu cầu đã được quản lý xác nhận ·&lt;br&gt;SNAPSHOT ngân sách: ngân sách · thực chi ·&lt;br&gt;cam kết đang giữ · còn lại · đang chờ duyệt ·&lt;br&gt;đánh giá rủi ro của IT (nếu SaaS mới)" vertex="1"><mxGeometry x="434" y="554" width="330" height="113" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Tôi là người yêu cầu&lt;br&gt;hoặc người thụ hưởng?" vertex="1"><mxGeometry x="524" y="751" width="240" height="98" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Không cho tự duyệt — bước thuộc người thay thế&lt;br&gt;khi xung đột do Quản trị hệ thống cấu hình trước;&lt;br&gt;chưa cấu hình thì chờ có kiểm soát&lt;br&gt;SoD-7 · FR-3.15 · BR-13.10" vertex="1"><mxGeometry x="0" y="933" width="330" height="96" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Bước duyệt chi do người thay thế xử lý&lt;br&gt;hoặc đang chờ có kiểm soát" vertex="1"><mxGeometry x="8" y="1149" width="285" height="79" as="geometry"/></mxCell><mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Quyết định của tôi?" vertex="1"><mxGeometry x="376" y="940" width="240" height="81" as="geometry"/></mxCell><mxCell id="s6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Hỏi Tài chính — tùy chọn; bước VẪN của tôi,&lt;br&gt;SLA KHÔNG dừng; câu trả lời không chặn&lt;br&gt;BR-07.9 · FR-3.14" vertex="1"><mxGeometry x="338" y="1149" width="318" height="79" as="geometry"/></mxCell><mxCell id="o2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSize=12;fontColor=#1F2933;" value="&lt;b&gt;UF-11&lt;/b&gt;&lt;br&gt;Tài chính trả lời yêu cầu thông tin" vertex="1"><mxGeometry x="56" y="1332" width="265" height="62" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;APV-02&lt;/b&gt;&lt;br&gt;Nhập lý do từ chối&lt;br&gt;BẮT BUỘC · BR-07.5" vertex="1"><mxGeometry x="702" y="1149" width="190" height="79" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Đã từ chối — không sinh khoản cam kết&lt;br&gt;BR-07.10" vertex="1"><mxGeometry x="672" y="1324" width="278" height="79" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Hệ thống tạo khoản cam kết ĐANG GIỮ ·&lt;br&gt;song song: Tài chính ghi nhận ∥ IT cấp phát&lt;br&gt;BR-07.10 · INV-16" vertex="1"><mxGeometry x="938" y="1149" width="318" height="79" as="geometry"/></mxCell><mxCell id="o1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#4A5C6E;strokeWidth=1.4;dashed=1;fontSiz