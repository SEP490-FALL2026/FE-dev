<mxfile host="app.diagrams.net" type="device"><diagram id="UF-03" name="UF-03 Nhân viên xem và xuất dữ liệu của chính mình"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1735" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-03 · Nhân viên xem và xuất dữ liệu của chính mình" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Employee — Ưu tiên trình bày: MỨC 3 · Chỉ mở khi bị hỏi — Tra cứu — mở khi thầy hỏi về quyền của người lao động với dữ liệu của chính họ" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Nhân viên muốn biết hệ thống&lt;br&gt;lưu gì về mình" vertex="1"><mxGeometry x="247" y="80" width="219" height="79" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;SYS-03 · Hồ sơ cá nhân&lt;/b&gt;&lt;br&gt;Mở mục “Dữ liệu của tôi”" vertex="1"><mxGeometry x="260" y="243" width="192" height="62" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;EMP-01 + EMP-03&lt;/b&gt;&lt;br&gt;Suất được cấp · lịch sử yêu cầu ·&lt;br&gt;dữ liệu sử dụng ĐÃ TỔNG HỢP · dữ liệu bộ thu thập&lt;br&gt;(tên miền · ngày · số phút) · phiên bản đã xác nhận&lt;br&gt;BR-40.1 — chỉ của chính mình" vertex="1"><mxGeometry x="192" y="389" width="330" height="113" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Muốn làm gì&lt;br&gt;với dữ liệu này?" vertex="1"><mxGeometry x="236" y="586" width="240" height="98" as="geometry"/></mxCell><mxCell id="a5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;SYS-03&lt;/b&gt;&lt;br&gt;Gửi yêu cầu DỪNG THU THẬP&lt;br&gt;trên thiết bị công ty · BR-42.6" vertex="1"><mxGeometry x="0" y="768" width="239" height="79" as="geometry"/></mxCell><mxCell id="s4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Xử lý theo quy trình quyền chủ thể dữ liệu;&lt;br&gt;xong thì thiết bị ngừng được nhận dữ liệu" vertex="1"><mxGeometry x="65" y="931" width="318" height="62" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Không còn dữ liệu mới từ thiết bị của tôi" vertex="1"><mxGeometry x="58" y="1086" width="305" height="62" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Đã xem trên màn hình" vertex="1"><mxGeometry x="285" y="776" width="190" height="62" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middl