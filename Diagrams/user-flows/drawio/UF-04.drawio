<mxfile host="app.diagrams.net" type="device"><diagram id="UF-04" name="UF-04 Quản lý duyệt yêu cầu cấp quyền"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1282" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" parent="1" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#1F2933;align=left;verticalAlign=middle;" value="UF-04 · Quản lý duyệt yêu cầu cấp quyền" vertex="1"><mxGeometry x="0" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;fontSize=12;fontColor=#5C6B7A;align=left;verticalAlign=middle;" value="Vai trò: Manager — Ưu tiên trình bày: MỨC 2 · Trình bày nếu còn thời gian — Cùng chuỗi D-1 với UF-01 nhưng nhìn từ phía người duyệt; mở khi thầy hỏi về phân tách trách nhiệm" vertex="1"><mxGeometry x="0" y="30" width="900" height="22" as="geometry"/></mxCell><mxCell id="st" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="BẮT ĐẦU&lt;br&gt;Có yêu cầu chờ tôi duyệt" vertex="1"><mxGeometry x="330" y="80" width="192" height="62" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-02&lt;/b&gt;&lt;br&gt;Hàng đợi chờ tôi duyệt — thời gian còn lại theo SLA.&lt;br&gt;Quá hạn thì nhắc và thông báo cấp trên, KHÔNG đổi&lt;br&gt;người, KHÔNG bao giờ tự duyệt (BR-07.7 · BR-13.8)" vertex="1"><mxGeometry x="261" y="226" width="330" height="96" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-03&lt;/b&gt;&lt;br&gt;Panel quyết định — khối “Bối cảnh cần biết”:&lt;br&gt;các suất người này đang giữ ở phần mềm&lt;br&gt;CÙNG NHÓM CHỨC NĂNG" vertex="1"><mxGeometry x="264" y="406" width="324" height="96" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Tôi là người yêu cầu&lt;br&gt;hoặc người tạo hộ?" vertex="1"><mxGeometry x="306" y="586" width="240" height="98" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Định tuyến lại theo cây: quản lý cấp trên,&lt;br&gt;người duyệt dự phòng ở gốc, hoặc chờ có kiểm soát&lt;br&gt;BR-02.2 · FR-3.3 · BR-13.6" vertex="1"><mxGeometry x="118" y="769" width="330" height="79" as="geometry"/></mxCell><mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#A8761B;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;" value="Quyết định của tôi?" vertex="1"><mxGeometry x="494" y="768" width="240" height="81" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Yêu cầu đã sang người duyệt hợp lệ khác,&lt;br&gt;hoặc đang chờ có kiểm soát" vertex="1"><mxGeometry x="0" y="933" width="298" height="79" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#78889B;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;" value="Chuyển bước kế tiếp: Người duyệt chi&lt;br&gt;nếu phát sinh chi phí,&lt;br&gt;nếu không thì IT Admin" vertex="1"><mxGeometry x="344" y="933" width="272" height="79" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6690;strokeWidth=1.6;fontSize=12;fontColor=#1F2933;verticalAlign=middle;" value="&lt;b&gt;MGR-03&lt;/b&gt;&lt;br&gt;Nhập lý do từ chối&lt;br&gt;BẮT BUỘC · BR-07.5" vertex="1"><mxGeometry x="662" y="933" width="190" height="79" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F8F4;strokeColor=#3B7A57;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Yêu cầu sang bước kế tiếp" vertex="1"><mxGeometry x="208" y="1096" width="199" height="62" as="geometry"/></mxCell><mxCell id="e4" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCF4F4;strokeColor=#A83C3C;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1F2933;" value="KẾT THÚC&lt;br&gt;Đã từ chối, có lý do" vertex="1"><mxGeometry x="454" y="1096" width="190" height="62" as="geometry"/></mxCell><mxCell id="UF-04_e0" edge="1" parent="1" source="st" target="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="426" y="168"/><mxPoint x="426" y="168"/></Array></mxGeometry></mxCell><mxCell id="UF-04_e1" edge="1" parent="1" source="a1" target="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="426" y="348"/><mxPoint x="426" y="348"/></Array></mxGeometry></mxCell><mxCell id="UF-04_e2" edge="1" parent="1" source="a3" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6B7A;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=11;fontCol