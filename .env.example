# Copy to .env for local development (http://localhost:5173).
# Only this template is versioned; keep actual values in ignored .env files.
# VITE_* values are public in the browser bundle; never put secrets in them.
# Generated API routes already contain /api/v1.
VITE_API_BASE_URL=/backend
API_PROXY_TARGET=https://wdp.novaproj.site

# Create .env.product for deployment builds with this value:
# VITE_API_BASE_URL=https://wdp.novaproj.site
# pnpm build uses --mode product to load .env.product.
